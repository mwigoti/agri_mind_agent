FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# GeoDjango loads the native GDAL, GEOS, and PROJ libraries at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the current application dependencies. The model artifact is a
# scikit-learn pickle, so install the version used by the local environment.
COPY requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt scikit-learn==1.8.0

# Copy only the Django project, app, static assets, and entry point.
COPY AgriVision/ ./AgriVision/
COPY base/ ./base/
COPY static/ ./static/
COPY manage.py ./manage.py

RUN addgroup --system app && adduser --system --ingroup app app \
    && mkdir -p /app/media /app/staticfiles \
    && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["gunicorn", "AgriVision.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--no-control-socket"]
