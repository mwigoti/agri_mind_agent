# Set DEMO_MODE=false only after MCP, database, and hosted-model configuration.
# Configure OpenRouter free-only inference with OPENROUTER_API_KEY.
DEMO_MODE=true
API_BEARER_TOKEN=dev-api-token
# Reviewer identity is mapped server-side; comma-separate identity:token entries.
REVIEWER_TOKENS=extension-officer-001:dev-reviewer-token

# Full integration configuration. Never commit actual credentials.
MODEL_ID=openrouter/free
MODEL_PROVIDER=auto
OPENROUTER_API_KEY=
HF_TOKEN=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_TIMEOUT=45
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=900
MODEL_RETRIES=2
AGRIMIND_MCP_COMMAND=
AGRIMIND_MCP_URL=
AGRIMIND_MCP_TOKEN=
HISTORICAL_MCP_COMMAND=
HISTORICAL_MCP_ENABLED=false
HISTORICAL_DB=./data/historical_records.db
CHECKPOINT_PATH=./agentic_layer_2/checkpoints.sqlite
AUDIT_PATH=./agentic_layer_2/audit.jsonl
