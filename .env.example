# Database Configuration
# Leave blank to use local SQLite (default for development)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrivision
DATABASE_URL=

# Django Settings
SECRET_KEY=django-insecure-agrivision-dev-secret-key-change-in-production
DEBUG=True

# Earth Engine
AGRIVISION_GEE_PROJECT=

# Africa's Talking (SMS / USSD)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SANDBOX=True

# Shared Hugging Face configuration for Layer 2 reasoning and Django agronomic reports.
# Use the same values in the Django and agent containers; live mode requires an HF token and MCP.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_PROVIDER=auto
HF_TOKEN=
MODEL_BASE_URL=https://router.huggingface.co/v1
DEMO_MODE=true
API_BEARER_TOKEN=replace-with-a-long-random-secret
REVIEWER_TOKEN=replace-with-a-separate-random-secret
REVIEWER_TOKENS=extension-officer:replace-with-a-separate-random-secret
AGRIMIND_MCP_COMMAND=
AGRIMIND_MCP_URL=
AGRIMIND_MCP_TOKEN=
HISTORICAL_MCP_ENABLED=false

# VRA satellite analysis engine (kept separate from AgriMind on port 8001).
VRA_ENGINE_URL=http://127.0.0.1:8003
VRA_ENGINE_TIMEOUT_SECONDS=900

# Optional external MCP endpoint. Leave MCP_TRANSPORT=stdio for Layer 2 local use.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8002
MCP_HTTP_PATH=/mcp
MCP_HTTP_BEARER_TOKEN=
MCP_ALLOWED_HOSTS=127.0.0.1:8002,localhost:8002
MCP_ALLOWED_ORIGINS=

